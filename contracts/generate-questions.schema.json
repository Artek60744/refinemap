{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generate-questions.schema.json",
  "title": "GenerateQuestionsOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions",
    "reasoningSummary",
    "potentialRisks",
    "missingAreas",
    "stopCriteria"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "theme", "priority", "question", "why"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]+$"
          },
          "theme": {
            "type": "string",
            "minLength": 2,
            "description": "The active grid axis label this question addresses."
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "question": {
            "type": "string",
            "minLength": 8
          },
          "why": {
            "type": "string",
            "minLength": 8
          },
          "suggestions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60
            },
            "description": "Short plausible answers offered to the user as one-click chips."
          }
        }
      }
    },
    "reasoningSummary": {
      "type": "string",
      "minLength": 10
    },
    "potentialRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingAreas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stopCriteria": {
      "type": "boolean"
    }
  }
}
