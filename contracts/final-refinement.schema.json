{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-refinement.schema.json",
  "title": "FinalRefinementOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "scope",
    "knownFacts",
    "assumptions",
    "proposedSplit",
    "crossCuttingConcerns",
    "deliveryPlan",
    "openQuestions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knownFacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposedSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyCount", "rationale", "stories"],
      "properties": {
        "storyCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "goal",
              "acceptanceCriteria",
              "technicalNotes",
              "dependencies",
              "risks"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 5
              },
              "goal": {
                "type": "string",
                "minLength": 10
              },
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "technicalNotes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "risks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "crossCuttingConcerns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testing",
        "cicd",
        "infra",
        "data",
        "security",
        "observability"
      ],
      "properties": {
        "testing": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cicd": {
          "type": "array",
          "items": { "type": "string" }
        },
        "infra": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "security": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observability": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "deliveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendedOrder", "milestones"],
      "properties": {
        "recommendedOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
