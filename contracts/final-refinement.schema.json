{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-refinement.schema.json",
  "title": "RefinementDeliverableOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "brief", "plan", "codeDraft", "openQuestions"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "brief": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "items"],
        "properties": {
          "heading": { "type": "string", "minLength": 2 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "detail": { "type": "string" }
        }
      }
    },
    "codeDraft": {
      "type": ["string", "null"]
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decisionReport": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "recommendation",
        "confidence",
        "reasons",
        "blockers",
        "strengths",
        "nextAction"
      ],
      "properties": {
        "recommendation": { "enum": ["go", "explore", "rework", "drop"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "reasons": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "blockers": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "strengths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextAction": { "type": "string" }
      }
    }
  }
}
