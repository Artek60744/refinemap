# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000
APP_ROOT=
LOG_FILE=logs/refinement.log
SECRET_KEY=change-me

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refinement
DATABASE_ECHO=false

# LLM
# Providers: mock | deepseek | openai | openrouter | azure-openai | azure-foundry
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000

# DeepSeek (OpenAI-compatible). Set LLM_PROVIDER=deepseek and paste your key below.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com

# Azure AI Foundry / Azure OpenAI style settings
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_MODEL_ID=

# OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Refinement tuning
REFINEMENT_MAX_ROUNDS=3
REFINEMENT_MAX_QUESTIONS_PER_ROUND=6
REFINEMENT_EXPORT_ENABLED=true

# Optional tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
