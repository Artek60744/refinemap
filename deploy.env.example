# Copy to deploy.env (untracked) and fill in with your own Azure resources.
# deploy.sh refuses to run if any of these is missing.
#
#   cp deploy.env.example deploy.env
#
# Note: the deployed app has no authentication. Do not expose it on a public IP
# without putting an access restriction in front of it.

AZ_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
AZ_RESOURCE_GROUP=rg-my-refinement
AZ_VM_NAME=vm-my-refinement
AZ_VM_USER=azureuser
AZ_VM_IP=203.0.113.10
AZ_SSH_KEY=$HOME/.ssh/my_refinement_key
AZ_REMOTE_DIR=/opt/refinement

# ssh | az | auto — "auto" prefers ssh and falls back to the Azure Run Command API.
DEPLOY_TRANSPORT=auto
